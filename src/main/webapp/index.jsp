<%@page import="java.util.List,java.util.Collections,com.incluyelab.model.Oferta,com.incluyelab.model.Empresa,com.incluyelab.model.FiltroOfertaPublica"%>
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@include file="WEB-INF/jspf/helpers.jspf"%>
<%
    if (request.getAttribute("ofertas") == null && request.getAttribute("error") == null) { response.sendRedirect(request.getContextPath() + "/inicio"); return; }
    List<Oferta> ofertas = (List<Oferta>) request.getAttribute("ofertas");
    if (ofertas == null) ofertas = Collections.emptyList();
    List<Empresa> empresasPublicas=(List<Empresa>)request.getAttribute("empresasPublicas");
    if(empresasPublicas==null)empresasPublicas=Collections.emptyList();
    List<Empresa> empresasFiltro=(List<Empresa>)request.getAttribute("empresasFiltro");
    if(empresasFiltro==null)empresasFiltro=Collections.emptyList();
    int paginaEmpresas=request.getAttribute("paginaEmpresas") instanceof Integer?(Integer)request.getAttribute("paginaEmpresas"):1;
    int totalPaginasEmpresas=request.getAttribute("totalPaginasEmpresas") instanceof Integer?(Integer)request.getAttribute("totalPaginasEmpresas"):1;
    FiltroOfertaPublica filtro=(FiltroOfertaPublica)request.getAttribute("filtro");
    if(filtro==null)filtro=new FiltroOfertaPublica();
    int totalOfertas=request.getAttribute("totalOfertas") instanceof Integer?(Integer)request.getAttribute("totalOfertas"):ofertas.size();
    int paginaActual=request.getAttribute("paginaActual") instanceof Integer?(Integer)request.getAttribute("paginaActual"):1;
    int totalPaginas=request.getAttribute("totalPaginas") instanceof Integer?(Integer)request.getAttribute("totalPaginas"):1;
    StringBuilder filtrosUrl=new StringBuilder();
    if(!filtro.getTexto().isEmpty())filtrosUrl.append("&q=").append(enc(filtro.getTexto()));
    if(!filtro.getUbicacion().isEmpty())filtrosUrl.append("&ubicacion=").append(enc(filtro.getUbicacion()));
    if(filtro.getIdEmpresa()!=null)filtrosUrl.append("&empresa=").append(filtro.getIdEmpresa());
    for(String valor:filtro.getModalidades())filtrosUrl.append("&modalidad=").append(enc(valor));
    for(String valor:filtro.getAdaptaciones())filtrosUrl.append("&adaptacion=").append(enc(valor));
    if(!"recent".equals(filtro.getOrden()))filtrosUrl.append("&orden=").append(enc(filtro.getOrden()));
    String paginaEmpresasUrl=paginaEmpresas>1?"&pagina_empresas="+paginaEmpresas:"";
%>
<!DOCTYPE html><html lang="es"><head><title>Empleo inclusivo en Perú | IncluyeLab</title><%@include file="WEB-INF/jspf/head.jspf"%></head>
<body data-context="<%=request.getContextPath()%>">
<%@include file="WEB-INF/jspf/header.jspf"%>
<main id="contenido">
    <section class="search-band" aria-labelledby="search-title"><div class="container">
        <div class="search-heading"><div><p class="eyebrow">TU TALENTO ES LO QUE IMPORTA</p><h1 id="search-title">Empleo inclusivo en Perú<span class="accent-dot">.</span></h1><p>Encuentra una oportunidad donde puedas ser tú y desarrollar todo tu potencial.</p></div><div class="ods-mark"><strong>10</strong><span>REDUCCIÓN DE LAS<br>DESIGUALDADES</span><i data-lucide="equal" aria-hidden="true"></i></div></div>
        <form class="search-form" id="job-search" action="<%=request.getContextPath()%>/inicio#ofertas" method="get" role="search">
            <div class="search-field"><label for="q">¿Qué empleo buscas?</label><div><i data-lucide="search" aria-hidden="true"></i><input class="form-control" id="q" name="q" type="search" placeholder="Cargo, habilidad o empresa" value="<%=h(request.getParameter("q"))%>"></div></div>
            <div class="search-field location-field"><label for="ubicacion">¿Dónde quieres trabajar?</label><div><i data-lucide="map-pin" aria-hidden="true"></i><input class="form-control" id="ubicacion" name="ubicacion" placeholder="Ciudad o distrito de Perú" value="<%=h(request.getParameter("ubicacion"))%>"></div></div>
            <button class="btn magenta" type="submit">Buscar empleo <i data-lucide="arrow-right" aria-hidden="true"></i></button>
        </form>
    </div></section>
    <section class="company-ribbon" aria-label="Empresas con ofertas activas"><div class="container ribbon-inner"><span>Conoce empresas<br><strong>con oportunidades activas</strong></span><% int logosMostrados=0; for(Empresa empresa:empresasPublicas){ if(logosMostrados++>=5)break; %><a href="<%=request.getContextPath()%>/empresa-publica?id=<%=empresa.getIdEmpresa()%>" aria-label="Conocer <%=h(empresa.getRazonSocial())%>"><% if(!empresa.getLogoPublico().isEmpty()){ %><img src="<%=request.getContextPath()%>/<%=h(empresa.getLogoPublico())%>" alt="<%=h(empresa.getRazonSocial())%>"><% }else{ %><i data-lucide="building-2" aria-hidden="true"></i><% } %></a><% } %><a href="#empresas" class="text-link">Ver todas <i data-lucide="arrow-right" aria-hidden="true"></i></a></div></section>
    <section class="container jobs-section" id="ofertas" aria-labelledby="offers-title">
        <div class="section-heading"><div><p class="eyebrow teal">OPORTUNIDADES PARA TI</p><h2 id="offers-title">Tu próximo paso empieza aquí</h2><p class="muted">Explora las ofertas y las adaptaciones disponibles para cada puesto.</p></div><button class="btn saved-filter" type="button" aria-pressed="false"><i data-lucide="bookmark" aria-hidden="true"></i> Guardadas <span id="saved-count">0</span></button></div>
        <% if (request.getAttribute("error") != null) { %><div class="alert alert-danger error" role="alert">No pudimos cargar las ofertas. Intenta nuevamente en unos minutos.</div><% } %>
        <div class="jobs-layout">
            <aside class="filters" aria-label="Filtros de empleo">
                <div class="filter-heading"><h3><i data-lucide="sliders-horizontal" aria-hidden="true"></i> Filtrar empleos</h3><button class="text-button" type="button" id="clear-filters">Limpiar</button></div>
                <fieldset><legend>Modalidad de trabajo</legend><label class="check"><input form="job-search" type="checkbox" name="modalidad" value="Remoto" <%=filtro.getModalidades().contains("Remoto")?"checked":""%>> Remoto</label><label class="check"><input form="job-search" type="checkbox" name="modalidad" value="Hibrido" <%=filtro.getModalidades().contains("Hibrido")?"checked":""%>> Híbrido</label><label class="check"><input form="job-search" type="checkbox" name="modalidad" value="Presencial" <%=filtro.getModalidades().contains("Presencial")?"checked":""%>> Presencial</label></fieldset>
                <fieldset><legend>Adaptaciones que necesitas</legend><label class="check"><input form="job-search" type="checkbox" name="adaptacion" value="movilidad" <%=filtro.getAdaptaciones().contains("movilidad")?"checked":""%>><span>Accesibilidad física / motora</span></label><label class="check"><input form="job-search" type="checkbox" name="adaptacion" value="visual" <%=filtro.getAdaptaciones().contains("visual")?"checked":""%>><span>Apoyo visual / lector de pantalla</span></label><label class="check"><input form="job-search" type="checkbox" name="adaptacion" value="auditiva" <%=filtro.getAdaptaciones().contains("auditiva")?"checked":""%>><span>Comunicación accesible / apoyo auditivo</span></label></fieldset>
                <fieldset><legend>Condiciones de trabajo</legend><label class="check"><input form="job-search" type="checkbox" name="adaptacion" value="flexible" <%=filtro.getAdaptaciones().contains("flexible")?"checked":""%>><span>Horario flexible</span></label><label class="check"><input form="job-search" type="checkbox" name="adaptacion" value="pausas" <%=filtro.getAdaptaciones().contains("pausas")?"checked":""%>><span>Pausas activas</span></label></fieldset>
                <div class="field"><label for="company-filter">Empresa</label><select form="job-search" class="form-select" id="company-filter" name="empresa"><option value="">Todas las empresas</option><% for (Empresa empresa : empresasFiltro) { %><option value="<%=empresa.getIdEmpresa()%>" <%=filtro.getIdEmpresa()!=null&&filtro.getIdEmpresa()==empresa.getIdEmpresa()?"selected":""%>><%=h(empresa.getRazonSocial())%></option><% } %></select></div>
                <div class="filter-support"><i data-lucide="heart-handshake" aria-hidden="true"></i><h3>El empleo se adapta a ti</h3><p>Tu discapacidad no define tu talento. Revisa los apoyos de cada oportunidad.</p></div>
            </aside>
            <div class="results">
                <div class="results-toolbar"><p id="result-count" role="status" aria-live="polite"><strong><%=totalOfertas%></strong> empleos disponibles</p><div><label for="sort">Ordenar por</label><select form="job-search" class="form-select" id="sort" name="orden"><option value="recent">Más recientes</option><option value="salary" <%="salary".equals(filtro.getOrden())?"selected":""%>>Mayor salario</option><option value="title" <%="title".equals(filtro.getOrden())?"selected":""%>>Título A–Z</option></select></div></div>
                <p id="saved-note" class="muted" hidden>Ofertas guardadas en este navegador.</p>
                <div class="offer-grid" id="offer-grid">
                <% for (Oferta o : ofertas) { %>
                    <article class="offer-card" data-id="<%=o.getIdOferta()%>" data-company="<%=h(o.getEmpresa())%>" data-title="<%=h(o.getTitulo())%>" data-location="<%=h(o.getUbicacion())%>" data-mode="<%=h(o.getModalidad())%>" data-adaptations="<%=h(o.getAdaptaciones())%>" data-supports="<%=h(o.getCategoriasApoyo())%>" data-salary="<%=o.getSalario()%>">
                        <div class="offer-top"><div class="company-identity"><span class="logo-box"><% if (!o.getLogoPublico().isEmpty()) { %><img src="<%=request.getContextPath()%>/<%=h(o.getLogoPublico())%>" alt="<%=h(o.getEmpresa())%>"><% } else { %><i data-lucide="building-2" aria-hidden="true"></i><% } %></span><span><strong><a href="<%=request.getContextPath()%>/empresa-publica?id=<%=o.getIdEmpresa()%>"><%=h(o.getEmpresa())%></a></strong><small>Oferta publicada</small></span></div><button class="icon-btn save-job" type="button" data-save="<%=o.getIdOferta()%>" aria-label="Guardar <%=h(o.getTitulo())%>" aria-pressed="false" title="Guardar oferta"><i data-lucide="bookmark" aria-hidden="true"></i></button></div>
                        <h3><button type="button" class="job-title" data-detail="<%=o.getIdOferta()%>"><%=h(o.getTitulo())%></button></h3>
                        <p class="offer-location"><i data-lucide="map-pin" aria-hidden="true"></i><%=h(o.getUbicacion())%></p>
                        <div class="tags"><span class="badge"><i data-lucide="briefcase-business" aria-hidden="true"></i><%=h(o.getModalidad())%></span><span class="salary">S/ <%=h(o.getSalario())%></span></div>
                        <div class="adaptations"><i data-lucide="accessibility" aria-hidden="true"></i><div><strong>Adaptaciones disponibles</strong><p><%=h(o.getAdaptaciones())%></p></div></div>
                        <% if (!o.getApoyos().isEmpty()) { %><p class="support-declarations"><%=h(o.getEtiquetasApoyo())%></p><% } %>
                        <div class="offer-bottom"><span>Postulación en el portal</span><a href="?oferta=<%=o.getIdOferta()%>#ofertas" data-detail="<%=o.getIdOferta()%>" class="text-link">Ver oferta <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
                        <template id="detail-<%=o.getIdOferta()%>"><header class="detail-hero"><div class="detail-brand"><% if (!o.getLogoPublico().isEmpty()) { %><img class="detail-logo" src="<%=request.getContextPath()%>/<%=h(o.getLogoPublico())%>" alt="<%=h(o.getEmpresa())%>"><% } %><div><p class="eyebrow teal"><%=h(o.getEmpresa())%></p><a class="text-link" href="<%=request.getContextPath()%>/empresa-publica?id=<%=o.getIdEmpresa()%>">Conocer empresa</a></div></div><h2 id="detail-title"><%=h(o.getTitulo())%></h2><div class="detail-meta"><span><i data-lucide="map-pin" aria-hidden="true"></i><%=h(o.getUbicacion())%></span><span><i data-lucide="briefcase-business" aria-hidden="true"></i><%=h(o.getModalidad())%></span><span><i data-lucide="banknote" aria-hidden="true"></i>S/ <%=h(o.getSalario())%> mensuales</span></div></header><section class="detail-accessibility"><div><span class="detail-section-icon"><i data-lucide="accessibility" aria-hidden="true"></i></span><div><h3>Adaptaciones disponibles</h3><p><%=h(o.getAdaptaciones())%></p><% if (!o.getApoyos().isEmpty()) { %><p class="support-declarations"><%=h(o.getEtiquetasApoyo())%></p><% } %></div></div></section><div class="job-detail-sections"><% for (Oferta.SeccionDetalle seccion : o.getSeccionesDetalle()) { %><section class="job-detail-section"><h3><%=h(seccion.getTitulo())%></h3><% for(String parrafo : seccion.getParrafos()) { %><p><%=h(parrafo)%></p><% } %><% if(!seccion.getItems().isEmpty()) { %><ul><% for(String item : seccion.getItems()) { %><li><%=h(item)%></li><% } %></ul><% } %></section><% } %></div><div class="detail-apply">
                        <% if (signedUser != null && "POSTULANTE".equals(signedUser.getRol())) { %><form method="post" action="<%=request.getContextPath()%>/postular"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("postulacionCsrf"))%>"><input type="hidden" name="idOferta" value="<%=o.getIdOferta()%>"><button class="btn magenta" type="submit">Postular a esta oferta <i data-lucide="arrow-right" aria-hidden="true"></i></button></form><% } else if (signedUser == null) { %><a class="btn magenta" href="<%=request.getContextPath()%>/login?oferta=<%=o.getIdOferta()%>">Ingresar y postular <i data-lucide="arrow-right" aria-hidden="true"></i></a><% } else { %><p>Las postulaciones están disponibles para cuentas de postulante.</p><a class="btn" href="<%=request.getContextPath()%>/<%=panelRoute%>">Ir a mi panel</a><% } %>
                        </div></template>
                    </article>
                <% } %>
                </div><% if(totalPaginas>1){ %><nav class="pagination-nav" aria-label="Páginas de ofertas"><% if(paginaActual>1){ %><a class="btn" href="?pagina=<%=paginaActual-1%><%=filtrosUrl%><%=paginaEmpresasUrl%>#ofertas">Anterior</a><% } %><span>Página <strong><%=paginaActual%></strong> de <%=totalPaginas%></span><% if(paginaActual<totalPaginas){ %><a class="btn" href="?pagina=<%=paginaActual+1%><%=filtrosUrl%><%=paginaEmpresasUrl%>#ofertas">Siguiente</a><% } %></nav><% } %>
                <div id="empty-results" class="empty-state" <%=ofertas.isEmpty() ? "" : "hidden"%>><i data-lucide="search-x" aria-hidden="true"></i><h3>No encontramos ofertas con estos criterios</h3><p>Prueba otra palabra o amplía tus filtros.</p><button class="btn primary" type="button" id="reset-results">Ver todos los empleos</button></div>
                <noscript><p>Activa JavaScript para utilizar los filtros y abrir el detalle, o <a href="<%=request.getContextPath()%>/postulante">ingresa para postular</a>.</p></noscript>
            </div>
        </div>
    </section>
    <section class="companies-section" id="empresas"><div class="container"><div class="section-heading"><div><p class="eyebrow teal">EMPRESAS CON OFERTAS</p><h2>Encuentra tu próximo equipo</h2><p class="muted">Aquí aparecen únicamente las empresas que tienen oportunidades laborales activas en IncluyeLab.</p></div><a class="text-link" href="<%=request.getContextPath()%>/registro?rol=EMPRESA">¿Buscas talento? <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div><div class="company-grid"><% for (Empresa empresa : empresasPublicas) { %><article class="company-tile"><a class="company-main" href="<%=request.getContextPath()%>/empresa-publica?id=<%=empresa.getIdEmpresa()%>"><% if(!empresa.getLogoPublico().isEmpty()){ %><img src="<%=request.getContextPath()%>/<%=h(empresa.getLogoPublico())%>" alt="Logo de <%=h(empresa.getRazonSocial())%>" loading="lazy"><% }else{ %><i data-lucide="building-2" aria-hidden="true"></i><% } %><strong><%=h(empresa.getRazonSocial())%></strong><span><%=h(empresa.getSector())%> · <%=h(empresa.getPais())%></span><span><%=empresa.getTotalOfertas()%> <%=empresa.getTotalOfertas()==1?"oferta activa":"ofertas activas"%></span><span class="text-link company-profile-link">Conocer empresa <i data-lucide="arrow-up-right" aria-hidden="true"></i></span></a><a class="company-official" href="?empresa=<%=empresa.getIdEmpresa()%>#ofertas">Ver ofertas <i data-lucide="briefcase-business" aria-hidden="true"></i></a></article><% } %></div><% if(empresasPublicas.isEmpty() && request.getAttribute("error")==null){ %><p class="empty-state">Por ahora no hay empresas con ofertas vigentes.</p><% } %><% if(totalPaginasEmpresas>1){ %><nav class="pagination-nav" aria-label="Páginas del directorio de empresas"><% if(paginaEmpresas>1){ %><a class="btn" href="?pagina_empresas=<%=paginaEmpresas-1%>&pagina=<%=paginaActual%><%=filtrosUrl%>#empresas">Anterior</a><% } %><span>Página <strong><%=paginaEmpresas%></strong> de <%=totalPaginasEmpresas%></span><% if(paginaEmpresas<totalPaginasEmpresas){ %><a class="btn" href="?pagina_empresas=<%=paginaEmpresas+1%>&pagina=<%=paginaActual%><%=filtrosUrl%>#empresas">Siguiente</a><% } %></nav><% } %></div></section>
    <section class="container guidance-section" id="orientacion"><div class="section-heading"><div><p class="eyebrow teal">TE ACOMPAÑAMOS</p><h2>Tu talento merece una oportunidad</h2><p class="muted">Una búsqueda de empleo a tu ritmo, con tus necesidades presentes.</p></div><span class="support-symbol"><i data-lucide="heart-handshake" aria-hidden="true"></i></span></div><div class="guidance-grid"><div><span class="step-number">01</span><h3>Encuentra los apoyos que necesitas</h3><p>Filtra por accesibilidad física, comunicación, apoyo visual y horarios flexibles.</p><a class="text-link" href="#ofertas">Explorar empleos <i data-lucide="arrow-right" aria-hidden="true"></i></a></div><div><span class="step-number">02</span><h3>Da el siguiente paso</h3><p>Crea tu cuenta y postula a las oportunidades que se ajustan a tu experiencia.</p><% if(signedUser==null){ %><a class="text-link" href="<%=request.getContextPath()%>/registro?rol=POSTULANTE">Crear mi cuenta <i data-lucide="arrow-right" aria-hidden="true"></i></a><% }else if("POSTULANTE".equals(signedUser.getRol())){ %><a class="text-link" href="<%=request.getContextPath()%>/postulante#postulaciones">Ir a mis postulaciones <i data-lucide="arrow-right" aria-hidden="true"></i></a><% }else{ %><a class="text-link" href="<%=request.getContextPath()%>/logout?destino=registro">Crear una cuenta de postulante <i data-lucide="arrow-right" aria-hidden="true"></i></a><% } %></div><div><span class="step-number">03</span><h3>Acompaña tu postulación</h3><p>Consulta desde tu panel las ofertas a las que postulaste y su estado registrado.</p><% if(signedUser==null){ %><a class="text-link" href="<%=request.getContextPath()%>/login">Iniciar sesión <i data-lucide="arrow-right" aria-hidden="true"></i></a><% }else if("POSTULANTE".equals(signedUser.getRol())){ %><a class="text-link" href="<%=request.getContextPath()%>/postulante#postulaciones">Mis postulaciones <i data-lucide="arrow-right" aria-hidden="true"></i></a><% }else{ %><a class="text-link" href="<%=request.getContextPath()%>/logout?destino=login">Ingresar como postulante <i data-lucide="arrow-right" aria-hidden="true"></i></a><% } %></div></div><div class="faq"><details><summary>¿Necesito declarar una discapacidad para registrarme?</summary><p>No. El registro solicita tu nombre, correo y contraseña. Puedes explorar las adaptaciones de las ofertas sin proporcionar información médica.</p></details><details><summary>¿Cómo sé si un puesto tiene las adaptaciones que necesito?</summary><p>Revisa la sección de adaptaciones en el detalle. Los apoyos indicados corresponden a la información registrada para esa oferta; confirma las condiciones concretas con la empresa durante el proceso.</p></details><details><summary>¿Dónde encuentro mis postulaciones?</summary><p>Ingresa con tu cuenta de postulante y abre Mi panel. Allí encontrarás el puesto, la empresa, la fecha y el estado de cada postulación.</p></details></div></section>
</main>
<dialog id="job-dialog" aria-labelledby="detail-title"><div class="dialog-top"><span>Detalle de la oportunidad</span><div class="visual-dialog-actions"><button class="btn" type="button" data-read-page>Escuchar oferta</button><button class="btn" type="button" data-read-pause disabled>Pausar lectura</button><button class="btn" type="button" data-read-stop disabled>Detener lectura</button><button class="icon-btn" type="button" data-close-dialog aria-label="Cerrar detalle" title="Cerrar"><i data-lucide="x" aria-hidden="true"></i></button></div></div><p class="visual-status visual-dialog-status" data-visual-status role="status" aria-live="polite" data-no-read></p><div class="dialog-content" id="dialog-content"></div></dialog>
<%@include file="WEB-INF/jspf/footer.jspf"%>
</body></html>
