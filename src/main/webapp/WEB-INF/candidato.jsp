<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="com.incluyelab.model.PerfilPostulante,com.incluyelab.model.Postulacion,com.incluyelab.model.EvaluacionRRHH"%>
<%@include file="jspf/helpers.jspf"%><% PerfilPostulante perfilProfesional=(PerfilPostulante)request.getAttribute("perfilProfesional");Postulacion candidatura=(Postulacion)request.getAttribute("postulacion");boolean vistaRrhh=Boolean.TRUE.equals(request.getAttribute("vistaRrhh"));java.util.List<EvaluacionRRHH> evaluacionesRrhh=(java.util.List<EvaluacionRRHH>)request.getAttribute("evaluacionesRrhh");if(evaluacionesRrhh==null)evaluacionesRrhh=java.util.Collections.emptyList(); %>
<!DOCTYPE html><html lang="es"><head><title>Candidato | IncluyeLab</title><%@include file="jspf/head.jspf"%></head><body><%@include file="jspf/header.jspf"%>
<main class="container professional-page" id="contenido"><a class="text-link" href="<%=request.getContextPath()%>/<%=vistaRrhh?"recursos-humanos":"empresa#candidatos"%>"><i data-lucide="arrow-left" aria-hidden="true"></i> Volver a candidatos</a>
<div class="candidate-context"><div><strong>Postulación a <%=h(candidatura.getOferta())%></strong><p><%=h(candidatura.getCorreo())%> · <%=h(candidatura.getFechaPostulacion())%></p></div><span class="badge"><%=h(candidatura.getEstado())%></span></div>
<%@include file="jspf/perfil-profesional-contenido.jspf"%>
<% if(!vistaRrhh){ %><section class="profile-section"><h2>Evaluación publicada por Recursos Humanos</h2><% for(EvaluacionRRHH e:evaluacionesRrhh){ %><article><div class="metric-grid"><div class="metric"><div><strong><%=e.getPuntajeCv()%>%</strong><span>CV</span></div></div><div class="metric"><div><strong><%=e.getPuntajeEntrevista()%>%</strong><span>Entrevista</span></div></div><div class="metric"><div><strong><%=e.getPuntajeDesempeno()%>%</strong><span>Desempeño</span></div></div><div class="metric"><div><strong><%=e.getPorcentajeCompatibilidad()%>%</strong><span>Compatibilidad</span></div></div></div><p><span class="badge"><%=h(e.getEtapa())%></span> <span class="badge"><%=h(e.getResultado())%></span> · Actualizada <%=h(e.getFechaActualizacionTexto())%></p><h3>Observaciones</h3><p><%=h(e.getObservaciones())%></p><h3>Retroalimentación</h3><p><%=h(e.getRetroalimentacion())%></p></article><% } %><% if(evaluacionesRrhh.isEmpty()){ %><p class="muted">Recursos Humanos todavía no ha publicado una evaluación para esta postulación.</p><% } %></section><section class="profile-section candidate-decision"><h2>Decisión de la empresa</h2><form method="post" action="<%=request.getContextPath()%>/empresa/postulacion"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("empresaCsrf"))%>"><input type="hidden" name="id" value="<%=candidatura.getIdPostulacion()%>"><div class="candidate-actions"><button class="btn" name="estado" value="en revision" type="submit"><i data-lucide="scan-search" aria-hidden="true"></i> Pasar a revisión</button><button class="btn primary" name="estado" value="aceptado" type="submit"><i data-lucide="user-check" aria-hidden="true"></i> Admitir</button></div></form></section><% }else{ %><section class="profile-section"><h2>Análisis de Recursos Humanos</h2><p>Regresa al panel para registrar porcentajes, entrevista, desempeño, retroalimentación y veredicto. Al marcarla como PUBLICADO, llegará automáticamente a la empresa correspondiente.</p></section><% } %>
</main><%@include file="jspf/footer.jspf"%></body></html>
