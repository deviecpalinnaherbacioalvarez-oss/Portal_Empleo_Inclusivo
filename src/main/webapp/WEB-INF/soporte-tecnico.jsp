<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@include file="jspf/helpers.jspf"%>
<%@page import="java.util.*,com.incluyelab.model.IncidenciaSoporte,com.incluyelab.model.Notificacion,com.incluyelab.model.UsuarioSoporte,com.incluyelab.model.AccionSoporte"%>
<%
List<IncidenciaSoporte> incidencias=(List<IncidenciaSoporte>)request.getAttribute("incidencias");
List<Notificacion> notificaciones=(List<Notificacion>)request.getAttribute("notificaciones");
List<UsuarioSoporte> usuariosSoporte=(List<UsuarioSoporte>)request.getAttribute("usuariosSoporte");
List<AccionSoporte> historial=(List<AccionSoporte>)request.getAttribute("historial");
if(incidencias==null)incidencias=Collections.emptyList();if(notificaciones==null)notificaciones=Collections.emptyList();if(usuariosSoporte==null)usuariosSoporte=Collections.emptyList();if(historial==null)historial=Collections.emptyList();
String csrf=String.valueOf(session.getAttribute("soporteCsrf"));
%>
<!DOCTYPE html><html lang="es"><head><title>Soporte Técnico | IncluyeLab</title><%@include file="jspf/head.jspf"%></head><body>
<%@include file="jspf/header.jspf"%><main class="container dashboard" id="contenido">
<div class="dashboard-heading"><div><p class="eyebrow teal">SEGURIDAD DE CUENTAS</p><h1>Soporte Técnico</h1><p>Gestiona tickets, verifica identidades y recupera accesos con trazabilidad completa.</p></div></div>
<% if(request.getParameter("ok")!=null){ %><div class="alert alert-success" role="status">Operación realizada y registrada en auditoría.</div><% } %>
<% if(request.getAttribute("claveTemporal")!=null){ %><div class="alert alert-warning" role="alert"><strong>Contraseña temporal para <%=h(request.getAttribute("correoTemporal"))%>:</strong> <code><%=h(request.getAttribute("claveTemporal"))%></code><br>Vigencia: <%=h(request.getAttribute("expiraTemporal"))%>. Se muestra una sola vez y no queda guardada en texto plano.</div><% } %>
<% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger" role="alert"><%=h(request.getAttribute("error"))%></div><% } %>

<section class="section" id="buscar-cuentas"><div class="section-toolbar"><div><h2>Buscar cuentas</h2><p class="muted">La vista muestra únicamente datos necesarios y oculta parcialmente el correo.</p></div></div>
<form method="get" action="<%=request.getContextPath()%>/soporte-tecnico" class="search-form"><label class="sr-only" for="buscarUsuario">Nombre, correo o ID</label><input class="form-control" id="buscarUsuario" name="buscarUsuario" value="<%=h(request.getParameter("buscarUsuario"))%>" placeholder="Nombre, correo o ID de usuario" maxlength="120" required><button class="btn primary" type="submit"><i data-lucide="search" aria-hidden="true"></i> Buscar</button></form>
<% if(request.getParameter("buscarUsuario")!=null){ %><div class="table-wrap table-responsive"><table class="table"><thead><tr><th>ID</th><th>Usuario</th><th>Correo protegido</th><th>Rol</th><th>Estado</th><th>Acceso</th></tr></thead><tbody><% for(UsuarioSoporte u:usuariosSoporte){ %><tr><td>#<%=u.getIdUsuario()%></td><td><strong><%=h(u.getNombre())%></strong></td><td><%=h(u.getCorreoOculto())%></td><td><%=h(u.getRol())%></td><td><span class="badge"><%=h(u.getEstado())%></span></td><td><% if(u.getBloqueadoHasta()!=null){ %>Bloqueada hasta <%=h(u.getBloqueadoHastaTexto())%><br><small><%=h(u.getMotivoBloqueo())%></small><% }else if(u.isRequiereCambioClave()){ %>Cambio de contraseña pendiente<% if(u.getClaveTemporalExpira()!=null){ %><br><small>Temporal vence: <%=h(u.getClaveTemporalExpiraTexto())%></small><% }}else{ %>Disponible<% } %></td></tr><% } %><% if(usuariosSoporte.isEmpty()){ %><tr><td colspan="6">No se encontraron cuentas.</td></tr><% } %></tbody></table></div><% } %>
</section>

<section class="section"><h2>Crear incidencia interna</h2><form method="post" class="form-grid"><input type="hidden" name="csrf" value="<%=h(csrf)%>"><input type="hidden" name="accion" value="crear"><div class="field"><label for="categoria-nueva">Categoría</label><select class="form-select" name="categoria" id="categoria-nueva"><option value="SEGURIDAD">Seguridad</option><option value="ACCESO">Acceso</option><option value="INFRACCION">Infracción</option><option value="TECNICO" selected>Técnico</option><option value="OTRO">Otro</option></select></div><div class="field"><label for="prioridad-nueva">Prioridad</label><select class="form-select" name="prioridad" id="prioridad-nueva"><option>BAJA</option><option selected>MEDIA</option><option>ALTA</option><option>URGENTE</option></select></div><div class="field"><label for="titulo-nuevo">Título</label><input class="form-control" name="titulo" id="titulo-nuevo" maxlength="150" required></div><div class="field" style="grid-column:1/-1"><label for="descripcion-nueva">Descripción y motivo del reporte</label><textarea class="form-control" name="descripcion" id="descripcion-nueva" maxlength="4000" required></textarea></div><button class="btn primary" type="submit"><i data-lucide="ticket-plus" aria-hidden="true"></i> Crear ticket</button></form></section>

<section class="section" id="tickets"><h2>Tickets asignados <span class="badge"><%=incidencias.size()%></span></h2>
<% for(IncidenciaSoporte i:incidencias){ boolean sensible="ACCESO".equals(i.getCategoria())||"SEGURIDAD".equals(i.getCategoria()); %>
<article class="profile-section"><div class="section-toolbar"><div><p class="eyebrow teal"><%=h(i.getNumeroTicket())%></p><h3><%=h(i.getTitulo())%></h3><p><span class="badge"><%=h(i.getCategoria())%></span> · Contacto: <%=h(i.getCorreoOculto())%> · <%=h(i.getFechaCreacionTexto())%></p></div><span class="badge"><%=h(i.getEstado())%></span></div>
<form method="post" class="form-grid"><input type="hidden" name="csrf" value="<%=h(csrf)%>"><input type="hidden" name="id" value="<%=i.getIdIncidencia()%>"><div class="field"><label>Título</label><input class="form-control" name="titulo" value="<%=h(i.getTitulo())%>" maxlength="150" required></div><div class="field"><label>Categoría</label><select class="form-select" name="categoria"><% for(String x:new String[]{"SEGURIDAD","ACCESO","INFRACCION","TECNICO","OTRO"}){ %><option <%=x.equals(i.getCategoria())?"selected":""%>><%=x%></option><% } %></select></div><div class="field"><label>Prioridad</label><select class="form-select" name="prioridad"><% for(String x:new String[]{"BAJA","MEDIA","ALTA","URGENTE"}){ %><option <%=x.equals(i.getPrioridad())?"selected":""%>><%=x%></option><% } %></select></div><div class="field"><label>Decisión del ticket</label><select class="form-select" name="decision"><% for(String x:new String[]{"PENDIENTE","ACEPTADA","RECHAZADA"}){ %><option <%=x.equals(i.getDecision())?"selected":""%>><%=x%></option><% } %></select></div><div class="field"><label>Estado</label><select class="form-select" name="estado"><% for(String x:new String[]{"PENDIENTE","EN_PROCESO","RESUELTA"}){ %><option <%=x.equals(i.getEstado())?"selected":""%>><%=x%></option><% } %></select></div><div class="field" style="grid-column:1/-1"><label>Descripción</label><textarea class="form-control" name="descripcion" maxlength="4000" required><%=h(i.getDescripcion())%></textarea></div><div class="field" style="grid-column:1/-1"><label>Solución y seguimiento</label><textarea class="form-control" name="solucion" maxlength="4000"><%=h(i.getSolucion())%></textarea></div><button class="btn" type="submit"><i data-lucide="save" aria-hidden="true"></i> Actualizar ticket</button></form>

<% if(sensible&&!i.isIdentidadVerificada()){ %><div class="profile-section"><h4>Verificar identidad</h4><p class="muted">Busca primero la cuenta y confirma con el usuario el correo completo que ya está registrado. El sistema comparará el dato en el servidor.</p><form method="post" class="form-grid"><input type="hidden" name="csrf" value="<%=h(csrf)%>"><input type="hidden" name="accion" value="verificar"><input type="hidden" name="id" value="<%=i.getIdIncidencia()%>"><div class="field"><label>ID del usuario seleccionado</label><input class="form-control" type="number" name="idUsuario" min="1" required></div><div class="field"><label>Método de verificación</label><select class="form-select" name="metodoVerificacion" required><option value="">Seleccionar</option><option value="CORREO_REGISTRADO">Correo registrado</option><option value="DOCUMENTO_REGISTRADO">Documento registrado</option><option value="VIDEOLLAMADA">Videollamada</option><option value="OTRO">Otro método documentado</option></select></div><div class="field"><label>Correo completo confirmado por el usuario</label><input class="form-control" type="email" name="correoConfirmado" maxlength="150" autocomplete="off" required></div><div class="field" style="grid-column:1/-1"><label>Motivo de la acción</label><textarea class="form-control" name="motivoAccion" maxlength="1000" required></textarea></div><label class="check" style="grid-column:1/-1"><input type="checkbox" name="identidadConfirmada" value="1" required> Confirmo que verifiqué la identidad y que el dato fue proporcionado por el titular.</label><button class="btn primary" type="submit"><i data-lucide="badge-check" aria-hidden="true"></i> Registrar verificación</button></form></div><% } %>

<% if(sensible&&i.isIdentidadVerificada()){ %><div class="alert alert-success"><strong>Identidad verificada.</strong> <%=h(i.getNombreUsuarioAfectado())%> · <%=h(i.getCorreoOculto())%> · <%=h(i.getMetodoVerificacion())%> · <%=h(i.getFechaVerificacionTexto())%><br>Estado de cuenta: <%=h(i.getEstadoCuenta())%>. Intentos fallidos: <%=i.getIntentosFallidos()%>. <% if(i.getBloqueadoHasta()!=null){ %>Bloqueada hasta <%=h(i.getBloqueadoHastaTexto())%>. Motivo: <%=h(i.getMotivoBloqueo())%>.<% } %></div><div class="candidate-actions"><form method="post"><input type="hidden" name="csrf" value="<%=h(csrf)%>"><input type="hidden" name="accion" value="desbloquear"><input type="hidden" name="id" value="<%=i.getIdIncidencia()%>"><button class="btn" type="submit"><i data-lucide="lock-open" aria-hidden="true"></i> Desbloquear cuenta</button></form><form method="post" onsubmit="return confirm('Se invalidará la contraseña actual y la temporal vencerá en 30 minutos.');"><input type="hidden" name="csrf" value="<%=h(csrf)%>"><input type="hidden" name="accion" value="restablecer"><input type="hidden" name="id" value="<%=i.getIdIncidencia()%>"><button class="btn primary" type="submit"><i data-lucide="key-round" aria-hidden="true"></i> Generar contraseña temporal</button></form></div><form method="post" class="form-grid"><input type="hidden" name="csrf" value="<%=h(csrf)%>"><input type="hidden" name="accion" value="notificar"><input type="hidden" name="id" value="<%=i.getIdIncidencia()%>"><div class="field"><label>Mensaje para el usuario</label><textarea class="form-control" name="mensaje" maxlength="1000" required></textarea></div><button class="btn" type="submit"><i data-lucide="send" aria-hidden="true"></i> Enviar notificación</button></form><% } %>
<% if("INTERNA".equals(i.getOrigen())&&"PENDIENTE".equals(i.getEstado())&&!i.isIdentidadVerificada()){ %><form method="post" onsubmit="return confirm('¿Eliminar esta incidencia interna?');"><input type="hidden" name="csrf" value="<%=h(csrf)%>"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="<%=i.getIdIncidencia()%>"><button class="btn btn-danger" type="submit"><i data-lucide="trash-2" aria-hidden="true"></i> Eliminar incidencia</button></form><% } %></article><% } %><% if(incidencias.isEmpty()){ %><p class="muted">No hay incidencias asignadas.</p><% } %></section>

<section class="section" id="auditoria"><h2>Historial de acciones</h2><div class="table-wrap table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Ticket</th><th>Usuario afectado</th><th>Acción</th><th>Método</th><th>Resultado</th><th>Motivo</th></tr></thead><tbody><% for(AccionSoporte a:historial){ %><tr><td><%=h(a.getFechaAccionTexto())%></td><td><%=h(a.getNumeroTicket())%></td><td><%=h(a.getUsuarioAfectado())%></td><td><%=h(a.getAccion())%></td><td><%=h(a.getMetodoVerificacion())%></td><td><span class="badge"><%=h(a.getResultado())%></span></td><td><%=h(a.getMotivo())%></td></tr><% } %><% if(historial.isEmpty()){ %><tr><td colspan="7">Aún no hay acciones auditadas.</td></tr><% } %></tbody></table></div></section>

<section class="section" id="notificaciones"><div class="section-toolbar"><h2>Notificaciones de Soporte</h2><form method="post" action="<%=request.getContextPath()%>/notificacion"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("notifCsrf"))%>"><input type="hidden" name="accion" value="todas"><button class="btn" type="submit"><i data-lucide="check-check"></i> Marcar todas como leídas</button></form></div><div class="application-list"><% for(Notificacion n:notificaciones){ %><article class="application-row <%=n.isLeida()?"notification-read":"notification-unread"%>"><div><h3><%=h(n.getTitulo())%></h3><p><%=h(n.getMensaje())%></p></div><div class="application-status"><span class="badge"><%=n.isLeida()?"Leída":"Nueva"%></span><small><%=h(n.getFechaCreacionTexto())%></small><% if(!n.isLeida()){ %><form method="post" action="<%=request.getContextPath()%>/notificacion"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("notifCsrf"))%>"><input type="hidden" name="id" value="<%=n.getIdNotificacion()%>"><button class="icon-btn" type="submit" aria-label="Marcar como leída"><i data-lucide="check"></i></button></form><% } %></div></article><% } %><% if(notificaciones.isEmpty()){ %><p class="muted">No hay notificaciones registradas.</p><% } %></div></section>
</main><%@include file="jspf/footer.jspf"%></body></html>
