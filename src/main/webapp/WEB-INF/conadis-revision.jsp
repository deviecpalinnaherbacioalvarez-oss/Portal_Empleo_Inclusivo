<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="com.incluyelab.model.VerificacionConadis,com.incluyelab.model.HistorialVerificacionConadis,java.util.List,java.util.Collections"%>
<%@include file="jspf/helpers.jspf"%>
<% VerificacionConadis v=(VerificacionConadis)request.getAttribute("verificacion");List<HistorialVerificacionConadis> historial=(List<HistorialVerificacionConadis>)request.getAttribute("historial");if(historial==null)historial=Collections.emptyList(); %>
<!DOCTYPE html><html lang="es"><head><title>Revisión de carnet · RRHH | IncluyeLab</title><%@include file="jspf/head.jspf"%></head><body><%@include file="jspf/header.jspf"%>
<main class="container dashboard" id="contenido"><a class="text-link" href="<%=request.getContextPath()%>/recursos-humanos#conadis"><i data-lucide="arrow-left" aria-hidden="true"></i> Volver a verificaciones</a>
<div class="dashboard-heading"><div><p class="eyebrow teal">REVISIÓN MANUAL · RECURSOS HUMANOS</p><h1>Solicitud CONADIS</h1><p>Cuenta: <strong><%=h(v.getNombreCuenta())%></strong> · <%=h(v.getCorreoCuenta())%></p></div><span class="badge"><%=h(v.getEstadoEfectivo())%></span></div>
<div class="alert alert-warning" role="note">El proyecto no tiene configurada una consulta oficial en línea. Verifica visualmente la información y registra una decisión manual responsable.</div>
<% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger" role="alert"><%=h(request.getAttribute("error"))%></div><% } %>
<div class="row g-4"><section class="col-lg-6 profile-section"><h2>Fotografía privada del carnet</h2><% if(v.isTieneImagen()){ %><img class="img-fluid" src="<%=request.getContextPath()%>/conadis-foto?usuario=<%=v.getIdUsuario()%>" alt="Carnet CONADIS enviado por el postulante"><p><a class="text-link" href="<%=request.getContextPath()%>/conadis-foto?usuario=<%=v.getIdUsuario()%>" target="_blank" rel="noopener">Ampliar imagen</a></p><% }else{ %><p>No hay imagen adjunta. La solicitud no puede aprobarse.</p><% } %><dl><dt>RUI enviado</dt><dd>RD<%=h(v.getRui())%></dd><dt>Fecha de solicitud</dt><dd><%=v.getFechaEnvio()==null?"":v.getFechaEnvio().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%></dd><dt>Número de envíos</dt><dd><%=v.getEnvios()%></dd></dl></section>
<section class="col-lg-6 profile-section"><h2>Resolución de RRHH</h2>
<% if("PENDIENTE".equals(v.getEstado())){ %><form method="post" action="<%=request.getContextPath()%>/revision-conadis"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("revisionConadisCsrf"))%>"><input type="hidden" name="id" value="<%=v.getIdUsuario()%>">
<div class="field"><label for="decision">Decisión</label><select class="form-select" id="decision" name="decision" required><option value="">Selecciona</option><option value="aprobar">Aprobar manualmente</option><option value="rechazar">Rechazar y solicitar corrección</option><option value="vencer">Marcar como vencida</option></select></div>
<div class="field"><label for="rui">RUI del carnet</label><input class="form-control" id="rui" name="rui" maxlength="20" data-dato-carnet value="<%=h(v.getRui())%>" readonly aria-readonly="true"></div>
<div class="field"><label for="dni">DNI del titular</label><input class="form-control" id="dni" name="dni" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" data-dato-carnet value="<%=h(request.getParameter("dni"))%>"></div>
<div class="field"><label for="nombres">Nombres</label><input class="form-control" id="nombres" name="nombres" maxlength="80" data-dato-carnet value="<%=h(request.getParameter("nombres"))%>"></div>
<div class="field"><label for="apellidos">Apellidos</label><input class="form-control" id="apellidos" name="apellidos" maxlength="80" data-dato-carnet value="<%=h(request.getParameter("apellidos"))%>"></div>
<div class="field"><label for="fechaCaducidad">Fecha de caducidad</label><input class="form-control" id="fechaCaducidad" name="fechaCaducidad" type="date" data-dato-carnet value="<%=h(request.getParameter("fechaCaducidad"))%>"></div>
<div class="field"><label for="idDiscapacidad">Discapacidad o necesidad</label><select class="form-select" id="idDiscapacidad" name="idDiscapacidad" data-dato-carnet><option value="">Selecciona según el carnet</option><% for(String[] op:(List<String[]>)request.getAttribute("discapacidades")){ %><option value="<%=op[0]%>" <%=op[0].equals(request.getParameter("idDiscapacidad"))?"selected":""%>><%=h(op[1])%></option><% } %></select></div>
<div class="field"><label for="motivo">Observación o motivo</label><textarea class="form-control" id="motivo" name="motivo" maxlength="1000" rows="4"><%=h(request.getParameter("motivo"))%></textarea><small>Obligatorio para rechazo o vencimiento.</small></div><button class="btn primary" type="submit">Guardar resolución</button></form>
<script>document.getElementById('decision').addEventListener('change',function(){document.querySelectorAll('[data-dato-carnet]').forEach(function(x){if(!x.readOnly)x.required=this.value==='aprobar';},this);document.getElementById('motivo').required=this.value==='rechazar'||this.value==='vencer';});</script>
<% }else if("APROBADA".equals(v.getEstado())){ %><dl><dt>Titular</dt><dd><%=h(v.getNombres())%> <%=h(v.getApellidos())%></dd><dt>DNI</dt><dd><%=h(v.getDni())%></dd><dt>Caducidad</dt><dd><%=h(v.getFechaCaducidad())%></dd><dt>Revisó</dt><dd><%=h(v.getNombreRevisor())%></dd></dl><form method="post" action="<%=request.getContextPath()%>/revision-conadis"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("revisionConadisCsrf"))%>"><input type="hidden" name="id" value="<%=v.getIdUsuario()%>"><input type="hidden" name="decision" value="vencer"><div class="field"><label for="motivo">Motivo del vencimiento</label><textarea class="form-control" id="motivo" name="motivo" minlength="10" maxlength="1000" required></textarea></div><button class="btn" type="submit">Marcar como vencida</button></form>
<% }else{ %><dl><dt>Estado</dt><dd><%=h(v.getEstadoEfectivo())%></dd><dt>Motivo</dt><dd><%=h(v.getMotivo())%></dd><dt>Revisó</dt><dd><%=h(v.getNombreRevisor())%></dd><dt>Fecha</dt><dd><%=v.getFechaRevision()==null?"":v.getFechaRevision().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%></dd></dl><p>El postulante puede corregir y reenviar la solicitud desde su sesión.</p><% } %></section></div>
<section class="section"><h2>Historial de auditoría</h2><div class="table-wrap table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Evento</th><th>Estado</th><th>Responsable</th><th>Motivo</th></tr></thead><tbody><% for(HistorialVerificacionConadis hst:historial){ %><tr><td><%=hst.getFechaEvento()==null?"":hst.getFechaEvento().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))%></td><td><%=h(hst.getAccion())%></td><td><span class="badge"><%=h(hst.getEstado())%></span></td><td><%=hst.getNombreRevisor()==null?"Postulante":h(hst.getNombreRevisor())%></td><td><%=h(hst.getMotivo())%></td></tr><% } %><% if(historial.isEmpty()){ %><tr><td colspan="5">Sin eventos registrados.</td></tr><% } %></tbody></table></div></section>
</main><%@include file="jspf/footer.jspf"%></body></html>
