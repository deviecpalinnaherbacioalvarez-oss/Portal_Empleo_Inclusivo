<%@page pageEncoding="UTF-8"%>
<%@page import="com.incluyelab.model.Usuario"%>
<%
    Usuario signedUser = (Usuario) session.getAttribute("usuario");
    String panelRoute = signedUser == null ? "login" : com.incluyelab.filter.SesionFilter.panel(signedUser).substring(1);
    String currentRoute = request.getRequestURI().substring(request.getContextPath().length());
    boolean loginKeyboardPage = "/login".equals(currentRoute) || "/login.jsp".equals(currentRoute);
%>
<a class="skip-link" href="#contenido">Saltar al contenido principal</a>
<div class="accessibility-bar"><div class="container accessibility-inner">
    <span class="a11y-caption"><i data-lucide="accessibility" aria-hidden="true"></i> Un espacio para todo tu talento</span>
    <div class="a11y-controls" role="group" aria-label="Preferencias de accesibilidad">
        <button type="button" data-preference="contrast" aria-pressed="false"><i data-lucide="contrast" aria-hidden="true"></i> Alto contraste</button>
        <button type="button" data-preference="font" aria-pressed="false"><i data-lucide="type" aria-hidden="true"></i> Fuente legible</button>
        <button type="button" data-preference="large" aria-pressed="false"><i data-lucide="a-arrow-up" aria-hidden="true"></i> Texto grande</button>
    </div>
</div></div>
<details class="visual-tools<%=loginKeyboardPage ? " login-keyboard-help" : ""%>" id="ayuda-visual"<%=loginKeyboardPage ? " open" : ""%>>
    <summary class="container"><i data-lucide="volume-2" aria-hidden="true"></i> Ayuda visual: escuchar y navegar</summary>
    <div class="container visual-tools-panel">
        <div class="visual-tools-actions" role="group" aria-label="Lectura por voz y navegación">
            <button class="btn" type="button" data-read-page<%=loginKeyboardPage ? " data-keyboard-box data-speech-label=\"Escuchar página\"" : ""%>>Escuchar página</button>
            <% if (loginKeyboardPage) { %>
            <button class="btn" type="button" data-read-mute aria-pressed="false" data-keyboard-box data-speech-label="Silenciar lectura">Silenciar lectura</button>
            <% } else { %>
            <button class="btn" type="button" data-read-pause disabled>Pausar lectura</button>
            <button class="btn" type="button" data-read-stop disabled>Detener lectura</button>
            <button class="btn" type="button" data-arrow-navigation aria-pressed="false" aria-describedby="visual-help">Navegar con flechas</button>
            <% } %>
        </div>
        <% if (loginKeyboardPage) { %>
        <div class="keyboard-symbols" id="visual-help" aria-label="Controles de navegación con teclado">
            <span><kbd>↑</kbd> Subir</span><span><kbd>↓</kbd> Bajar</span><span><kbd>←</kbd> Lado izquierdo</span><span><kbd>→</kbd> Lado derecho</span><span><kbd>Enter</kbd> Entrar y salir del recuadro</span>
        </div>
        <% } else { %>
        <label class="check"><input type="checkbox" data-read-focus> Leer el nombre del control al navegar</label>
        <p id="visual-help">Activa las flechas para avanzar (↓ / →) o retroceder (↑ / ←) entre enlaces y botones. Usa Tab para salir de un campo de texto o selector y Enter para activar un control. Escape detiene la voz. La lectura comienza solo al solicitarla.</p>
        <p class="visual-status" data-visual-status role="status" aria-live="polite"></p>
        <a class="text-link" href="<%=request.getContextPath()%>/accesibilidad">Ver las 13 necesidades de accesibilidad y su estado</a>
        <% } %>
        <noscript><p>Activa JavaScript para usar estas ayudas. La navegación habitual con Tab sigue disponible.</p></noscript>
    </div>
</details>
<header class="topbar"><div class="container header-inner">
    <a class="brand" href="<%=request.getContextPath()%>/inicio" aria-label="IncluyeLab, inicio"><span class="brand-symbol"><i data-lucide="accessibility" aria-hidden="true"></i></span><span>incluye<strong>lab</strong><small>Talento sin barreras</small></span></a>
    <button class="icon-btn menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav"><i data-lucide="menu" aria-hidden="true"></i></button>
    <nav class="nav" id="main-nav" aria-label="Navegación principal">
        <a href="<%=request.getContextPath()%>/inicio#ofertas" data-keyboard-box data-speech-label="Buscar empleo">Buscar empleo</a><a href="<%=request.getContextPath()%>/inicio#empresas" data-keyboard-box data-speech-label="Empresas">Empresas</a><a href="<%=request.getContextPath()%>/inicio#orientacion" data-keyboard-box data-speech-label="Te acompañamos">Te acompañamos</a>
        <% if (signedUser == null) { %>
        <a class="nav-login" href="<%=request.getContextPath()%>/login" data-keyboard-box data-speech-label="Ingresar"><i data-lucide="user-round" aria-hidden="true"></i> Ingresar</a><a class="btn primary" href="<%=request.getContextPath()%>/registro" data-keyboard-box data-speech-label="Crear cuenta">Crear cuenta <i data-lucide="arrow-up-right" aria-hidden="true"></i></a>
        <% } else { %>
        <a class="nav-login" href="<%=request.getContextPath()%>/perfil"><i data-lucide="user-round" aria-hidden="true"></i> Mi perfil</a>
        <a class="btn primary" href="<%=request.getContextPath()%>/<%=panelRoute%>"><i data-lucide="layout-dashboard" aria-hidden="true"></i> Mi panel</a><a class="icon-btn" href="<%=request.getContextPath()%>/logout" aria-label="Cerrar sesión" title="Cerrar sesión"><i data-lucide="log-out" aria-hidden="true"></i></a>
        <% } %>
    </nav>
</div></header>
