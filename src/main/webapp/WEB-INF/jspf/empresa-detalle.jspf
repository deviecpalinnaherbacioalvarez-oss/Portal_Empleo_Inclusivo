<%@page pageEncoding="UTF-8"%>
<div class="business-heading"><span class="logo-box"><% if(!ficha.getLogoPublico().isEmpty()){ %><img src="<%=request.getContextPath()%>/<%=h(ficha.getLogoPublico())%>" alt="Logo de <%=h(ficha.getRazonSocial())%>"><% }else{ %><i data-lucide="building-2" aria-hidden="true"></i><% } %></span><div><p class="eyebrow teal"><%=h(ficha.getSector())%></p><h1><%=h(ficha.getRazonSocial())%></h1></div></div>
<div class="business-facts"><div><strong>Tipo de negocio</strong><p><%=ficha.getSector()==null || ficha.getSector().isEmpty()?"Por completar":h(ficha.getSector())%></p></div><div><strong>Inicio de actividades</strong><p><%=ficha.getAnioInicio()==null?"Por completar":ficha.getAnioInicio()%></p></div><div><strong>Trayectoria</strong><p><%=ficha.getAnioInicio()==null?"Por completar":Math.max(0,java.time.Year.now().getValue()-ficha.getAnioInicio())+" años"%></p></div></div>
<section class="business-copy"><h2>Conoce nuestro negocio</h2><p class="preserve-lines"><%=ficha.getPresentacion().isEmpty()?"La empresa aún no ha completado su presentación.":h(ficha.getPresentacion())%></p></section>
<section class="business-copy"><h2>Logros y metas cumplidas</h2><p class="preserve-lines"><%=ficha.getLogros().isEmpty()?"No se han registrado logros ni metas cumplidas.":h(ficha.getLogros())%></p></section>
