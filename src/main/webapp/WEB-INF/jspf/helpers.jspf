<%@page pageEncoding="UTF-8"%>
<%!
    private String h(Object value) {
        if (value == null) return "";
        return value.toString().replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;");
    }
    private String enc(Object value) {
        try { return java.net.URLEncoder.encode(value == null ? "" : value.toString(), "UTF-8"); }
        catch (java.io.UnsupportedEncodingException ex) { return ""; }
    }
%>
