<%@page pageEncoding="UTF-8"%>
<section class="candidate-hero">
  <div class="candidate-cover"></div>
  <div class="candidate-main"><div class="candidate-photo-wrap"><% String fotoPerfil=perfilProfesional.getFotoUrl();if(fotoPerfil!=null&&!fotoPerfil.isEmpty()){String fotoSrc=fotoPerfil.startsWith("asset:")?request.getContextPath()+"/assets/img/"+fotoPerfil.substring(6):request.getContextPath()+"/foto-perfil?usuario="+perfilProfesional.getIdUsuario(); %><img class="candidate-photo" src="<%=h(fotoSrc)%>" alt="Foto de perfil de <%=h(perfilProfesional.getNombre())%>"><% }else{ %><span class="candidate-photo candidate-photo-placeholder" role="img" aria-label="Perfil sin fotografía"><i data-lucide="user-round" aria-hidden="true"></i></span><small>Foto por completar</small><% } %></div>
  <div class="candidate-title"><p class="eyebrow teal">PERFIL PROFESIONAL</p><h1><%=h(perfilProfesional.getNombre())%></h1><p><%=perfilProfesional.getTitular().isEmpty()?"Completa tu titular profesional":h(perfilProfesional.getTitular())%></p><p class="muted"><i data-lucide="map-pin" aria-hidden="true"></i> <%=perfilProfesional.getUbicacion().isEmpty()?"Ubicación por completar":h(perfilProfesional.getUbicacion())%></p></div></div>
</section>
<div class="professional-grid">
  <div class="professional-content">
    <section class="profile-section"><div class="profile-section-heading"><div><p class="eyebrow teal">PRESENTACIÓN</p><h2>Acerca de</h2></div></div><p class="preserve-lines"><%=perfilProfesional.getAcercaDe().isEmpty()?"Aún no se agregó una presentación profesional.":h(perfilProfesional.getAcercaDe())%></p></section>
    <section class="profile-section"><div class="profile-section-heading"><h2>Experiencia</h2></div><% if(perfilProfesional.getExperiencias().isEmpty()){ %><p class="muted">Sin experiencia registrada.</p><% } %><% for(com.incluyelab.model.PerfilPostulante.Experiencia x:perfilProfesional.getExperiencias()){ %><article class="resume-entry"><span class="entry-icon"><i data-lucide="briefcase-business" aria-hidden="true"></i></span><div><h3><%=h(x.getCargo())%></h3><p><strong><%=h(x.getOrganizacion())%></strong></p><p class="muted"><%=h(x.getInicio())%> – <%=h(x.getFin())%></p><p class="preserve-lines"><%=h(x.getDescripcion())%></p></div></article><% } %></section>
    <section class="profile-section"><div class="profile-section-heading"><h2>Educación</h2></div><% if(perfilProfesional.getEducacion().isEmpty()){ %><p class="muted">Sin educación registrada.</p><% } %><% for(com.incluyelab.model.PerfilPostulante.Educacion x:perfilProfesional.getEducacion()){ %><article class="resume-entry"><span class="entry-icon"><i data-lucide="graduation-cap" aria-hidden="true"></i></span><div><h3><%=h(x.getInstitucion())%></h3><p><strong><%=h(x.getCarrera())%></strong></p><p class="muted"><%=h(x.getInicio())%> – <%=h(x.getFin())%></p><p class="preserve-lines"><%=h(x.getDescripcion())%></p></div></article><% } %></section>
    <section class="profile-section"><div class="profile-section-heading"><h2>Licencias y certificaciones</h2></div><% if(perfilProfesional.getCertificaciones().isEmpty()){ %><p class="muted">Sin certificaciones registradas.</p><% } %><% for(com.incluyelab.model.PerfilPostulante.Certificacion x:perfilProfesional.getCertificaciones()){ %><article class="resume-entry"><span class="entry-icon"><i data-lucide="badge-check" aria-hidden="true"></i></span><div><h3><%=h(x.getNombre())%></h3><p><strong><%=h(x.getEmisor())%></strong> · <%=h(x.getFecha())%></p><% if(!x.getUrl().isEmpty()){ %><a class="text-link" href="<%=h(x.getUrl())%>" target="_blank" rel="noopener noreferrer">Mostrar credencial <i data-lucide="external-link" aria-hidden="true"></i></a><% } %></div></article><% } %></section>
  </div>
  <aside class="professional-sidebar">
    <section class="profile-section"><h2>Habilidades</h2><p class="preserve-lines"><%=perfilProfesional.getHabilidades().isEmpty()?"Por completar":h(perfilProfesional.getHabilidades())%></p></section>
    <section class="profile-section"><h2>Apoyos preferidos</h2><p class="preserve-lines"><%=perfilProfesional.getAdaptacionRequerida().isEmpty()?"No declarados":h(perfilProfesional.getAdaptacionRequerida())%></p></section>
    <section class="profile-section"><h2>Currículum</h2><% if(!perfilProfesional.getCvArchivo().isEmpty()){ %><p><i data-lucide="file-text" aria-hidden="true"></i> <%=h(perfilProfesional.getCvNombre())%></p><a class="btn primary" href="<%=request.getContextPath()%>/cv?usuario=<%=perfilProfesional.getIdUsuario()%>" target="_blank">Ver CV <i data-lucide="external-link" aria-hidden="true"></i></a><% }else{ %><p class="muted">No se adjuntó un CV.</p><% } %></section>
  </aside>
</div>
