<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="com.incluyelab.model.PerfilPostulante"%>
<%@include file="jspf/helpers.jspf"%><% PerfilPostulante perfilProfesional=(PerfilPostulante)request.getAttribute("perfilProfesional");Object notice=session.getAttribute("profileNotice");session.removeAttribute("profileNotice"); %>
<!DOCTYPE html><html lang="es"><head><title>Mi perfil profesional | IncluyeLab</title><%@include file="jspf/head.jspf"%></head><body><%@include file="jspf/header.jspf"%>
<main class="container professional-page" id="contenido">
<div class="professional-toolbar"><a class="text-link" href="<%=request.getContextPath()%>/postulante"><i data-lucide="arrow-left" aria-hidden="true"></i> Volver a mi panel</a><div class="candidate-actions"><a class="btn" href="#foto-perfil-form"><i data-lucide="camera" aria-hidden="true"></i> Cambiar foto</a><a class="btn" href="<%=request.getContextPath()%>/perfil?seguridad=1"><i data-lucide="lock-keyhole" aria-hidden="true"></i> Seguridad y contraseña</a></div></div>
<% if(notice!=null){ %><div class="alert alert-success" role="status"><%=h(notice)%></div><% } %><% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger" role="alert"><%=h(request.getAttribute("error"))%></div><% } %>
<%@include file="jspf/perfil-profesional-contenido.jspf"%>
<section class="profile-editor" aria-labelledby="editar-perfil"><div class="profile-section-heading"><div><p class="eyebrow teal">EDITAR PERFIL</p><h2 id="editar-perfil">Haz visible tu experiencia</h2></div></div>
<details id="foto-perfil-form" open><summary>Foto de perfil</summary><form method="post" enctype="multipart/form-data" action="<%=request.getContextPath()%>/perfil-profesional" class="profile-form"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="foto"><div class="field"><label for="foto">Seleccionar una foto</label><input class="form-control" id="foto" name="foto" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" required><small>JPG o PNG, máximo 5 MB. La imagen se procesa de forma segura y aparecerá en tu perfil profesional.</small></div><button class="btn primary" type="submit"><i data-lucide="camera" aria-hidden="true"></i> Guardar foto</button></form></details>
<details open><summary>Información principal</summary><form method="post" action="<%=request.getContextPath()%>/perfil-profesional" class="profile-form"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="resumen"><div class="row g-3">
<div class="field col-md-6"><label for="nombre">Nombre completo</label><input class="form-control" id="nombre" name="nombre" maxlength="170" <%=perfilProfesional.getDatosConadis()!=null?"readonly aria-readonly=\"true\"":""%> value="<%=h(perfilProfesional.getNombre())%>" required></div><div class="field col-md-6"><label for="telefono">Teléfono</label><input class="form-control" id="telefono" name="telefono" maxlength="20" value="<%=h(perfilProfesional.getTelefono())%>" required></div>
<div class="field col-12"><label for="titular">Titular profesional</label><input class="form-control" id="titular" name="titular" maxlength="160" placeholder="Ej. Desarrollador Java junior | SQL y soporte TI" value="<%=h(perfilProfesional.getTitular())%>" required></div><div class="field col-12"><label for="ubicacion">Ubicación</label><input class="form-control" id="ubicacion" name="ubicacion" maxlength="120" value="<%=h(perfilProfesional.getUbicacion())%>" placeholder="Lima, Perú" required></div>
<div class="field col-12"><label for="acercaDe">Acerca de</label><textarea class="form-control" id="acercaDe" name="acercaDe" rows="5" maxlength="5000" required><%=h(perfilProfesional.getAcercaDe())%></textarea></div><div class="field col-md-6"><label for="habilidades">Habilidades</label><textarea class="form-control" id="habilidades" name="habilidades" rows="4" maxlength="1000" placeholder="Java, MySQL, HTML, trabajo en equipo" required><%=h(perfilProfesional.getHabilidades())%></textarea></div><div class="field col-md-6"><label for="adaptacion">Apoyos o adaptaciones preferidas <span class="muted">(opcional)</span></label><textarea class="form-control" id="adaptacion" name="adaptacion" rows="4" maxlength="1000" placeholder="Comparte solo los apoyos laborales que desees"><%=h(perfilProfesional.getAdaptacionRequerida())%></textarea></div></div><button class="btn primary" type="submit"><i data-lucide="save" aria-hidden="true"></i> Guardar perfil</button></form></details>
<% if(perfilProfesional.getDatosConadis()!=null){com.incluyelab.model.VerificacionConadis datos=perfilProfesional.getDatosConadis(); %><section class="section" aria-labelledby="datos-rrhh"><h2 id="datos-rrhh">Datos verificados por RRHH</h2><p>Estos datos provienen de tu carnet y no puedes modificarlos.</p><dl class="row"><dt class="col-sm-4">Nombres</dt><dd class="col-sm-8"><%=h(datos.getNombres())%></dd><dt class="col-sm-4">Apellidos</dt><dd class="col-sm-8"><%=h(datos.getApellidos())%></dd><dt class="col-sm-4">DNI</dt><dd class="col-sm-8"><%=h(datos.getDni())%></dd><dt class="col-sm-4">RUI</dt><dd class="col-sm-8">RD<%=h(datos.getRui())%></dd><dt class="col-sm-4">Discapacidad o necesidad</dt><dd class="col-sm-8"><%=h(datos.getDiscapacidad())%></dd><dt class="col-sm-4">Caducidad del carnet</dt><dd class="col-sm-8"><%=h(datos.getFechaCaducidad())%></dd></dl></section><% } %><details><summary>Currículum en PDF</summary><form method="post" enctype="multipart/form-data" action="<%=request.getContextPath()%>/perfil-profesional" class="profile-form"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="cv"><div class="field"><label for="cv">Adjuntar CV</label><input class="form-control" id="cv" name="cv" type="file" accept="application/pdf,.pdf" required><small>Solo PDF, máximo 5 MB. Las empresas podrán verlo únicamente cuando postules a sus ofertas.</small></div><button class="btn primary" type="submit"><i data-lucide="upload" aria-hidden="true"></i> Guardar CV</button></form></details>
<details><summary>Añadir experiencia</summary><form method="post" action="<%=request.getContextPath()%>/perfil-profesional" class="profile-form"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="experiencia"><div class="row g-3"><div class="field col-md-6"><label>Cargo</label><input class="form-control" name="cargo" maxlength="150" required></div><div class="field col-md-6"><label>Organización</label><input class="form-control" name="organizacion" maxlength="150" required></div><div class="field col-md-6"><label>Inicio</label><input class="form-control" name="inicio" maxlength="30" placeholder="Mar. 2024" required></div><div class="field col-md-6"><label>Fin</label><input class="form-control" name="fin" maxlength="30" placeholder="Actualidad" required></div><div class="field col-12"><label>Descripción</label><textarea class="form-control" name="descripcion" rows="3" maxlength="2000" required></textarea></div></div><button class="btn primary" type="submit"><i data-lucide="plus" aria-hidden="true"></i> Añadir experiencia</button></form></details>
<details><summary>Añadir educación</summary><form method="post" action="<%=request.getContextPath()%>/perfil-profesional" class="profile-form"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="educacion"><div class="row g-3"><div class="field col-md-6"><label>Institución</label><input class="form-control" name="institucion" maxlength="180" required></div><div class="field col-md-6"><label>Carrera o programa</label><input class="form-control" name="carrera" maxlength="180" required></div><div class="field col-md-6"><label>Inicio</label><input class="form-control" name="inicio" maxlength="30" required></div><div class="field col-md-6"><label>Fin</label><input class="form-control" name="fin" maxlength="30" required></div><div class="field col-12"><label>Descripción</label><textarea class="form-control" name="descripcion" rows="3" maxlength="2000" required></textarea></div></div><button class="btn primary" type="submit"><i data-lucide="plus" aria-hidden="true"></i> Añadir educación</button></form></details>
<details><summary>Añadir certificación</summary><form method="post" action="<%=request.getContextPath()%>/perfil-profesional" class="profile-form"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="certificacion"><div class="row g-3"><div class="field col-md-6"><label>Certificación</label><input class="form-control" name="nombreCert" maxlength="200" required></div><div class="field col-md-6"><label>Entidad emisora</label><input class="form-control" name="emisor" maxlength="150" required></div><div class="field col-md-6"><label>Fecha de emisión</label><input class="form-control" name="fecha" maxlength="30" required></div><div class="field col-md-6"><label>Enlace de credencial (opcional)</label><input class="form-control" name="url" type="url" maxlength="500"></div></div><button class="btn primary" type="submit"><i data-lucide="plus" aria-hidden="true"></i> Añadir certificación</button></form></details>
<% if(!perfilProfesional.getExperiencias().isEmpty()||!perfilProfesional.getEducacion().isEmpty()||!perfilProfesional.getCertificaciones().isEmpty()){ %><details><summary>Administrar elementos</summary><div class="manage-profile-items"><% for(PerfilPostulante.Experiencia x:perfilProfesional.getExperiencias()){ %><form method="post" action="<%=request.getContextPath()%>/perfil-profesional"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="tipo" value="experiencia"><input type="hidden" name="id" value="<%=x.getId()%>"><span>Experiencia: <%=h(x.getCargo())%></span><button class="icon-btn danger-action" type="submit" aria-label="Eliminar experiencia"><i data-lucide="trash-2"></i></button></form><% } %><% for(PerfilPostulante.Educacion x:perfilProfesional.getEducacion()){ %><form method="post" action="<%=request.getContextPath()%>/perfil-profesional"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="tipo" value="educacion"><input type="hidden" name="id" value="<%=x.getId()%>"><span>Educación: <%=h(x.getInstitucion())%></span><button class="icon-btn danger-action" type="submit" aria-label="Eliminar educación"><i data-lucide="trash-2"></i></button></form><% } %><% for(PerfilPostulante.Certificacion x:perfilProfesional.getCertificaciones()){ %><form method="post" action="<%=request.getContextPath()%>/perfil-profesional"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("perfilCsrf"))%>"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="tipo" value="certificacion"><input type="hidden" name="id" value="<%=x.getId()%>"><span>Certificación: <%=h(x.getNombre())%></span><button class="icon-btn danger-action" type="submit" aria-label="Eliminar certificación"><i data-lucide="trash-2"></i></button></form><% } %></div></details><% } %>
</section></main><%@include file="jspf/footer.jspf"%></body></html>
