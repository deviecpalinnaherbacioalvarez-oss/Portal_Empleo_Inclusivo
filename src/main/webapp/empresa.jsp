<%@page import="java.util.List,java.util.Collections,com.incluyelab.model.Postulacion,com.incluyelab.model.Oferta,com.incluyelab.model.Empresa,com.incluyelab.model.Usuario,com.incluyelab.model.EvaluacionRRHH"%>
<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@include file="WEB-INF/jspf/helpers.jspf"%>
<%
    Usuario usuario = (Usuario) session.getAttribute("usuario");
    if (usuario == null || !"EMPRESA".equals(usuario.getRol())) { response.sendRedirect(request.getContextPath()+"/login"); return; }
    if (request.getAttribute("empresa") == null && request.getAttribute("error") == null && request.getRequestURI().endsWith(".jsp")) { response.sendRedirect(request.getContextPath()+"/empresa"); return; }
    Empresa empresa = (Empresa) request.getAttribute("empresa");
    List<Oferta> ofertas = (List<Oferta>) request.getAttribute("ofertas");
    if (ofertas == null) ofertas = Collections.emptyList();
    List<Postulacion> candidatos=(List<Postulacion>)request.getAttribute("candidatos");
    if(candidatos==null)candidatos=Collections.emptyList();
    List<EvaluacionRRHH> evaluacionesRrhh=(List<EvaluacionRRHH>)request.getAttribute("evaluacionesRrhh");
    if(evaluacionesRrhh==null)evaluacionesRrhh=Collections.emptyList();
    Oferta ofertaEditar=(Oferta)request.getAttribute("ofertaEditar");
    Object empresaNotice=session.getAttribute("empresaNotice");session.removeAttribute("empresaNotice");
    Object empresaError=session.getAttribute("empresaError");session.removeAttribute("empresaError");
%>
<!DOCTYPE html><html lang="es"><head><title>Panel de empresa | IncluyeLab</title><%@include file="WEB-INF/jspf/head.jspf"%></head><body>
<%@include file="WEB-INF/jspf/header.jspf"%>
<main class="container dashboard" id="contenido">
    <div class="dashboard-heading"><div><p class="eyebrow teal">MI ESPACIO · EMPRESA</p><h1>Conecta con el talento que buscas</h1><p><%=h(empresa == null ? usuario.getNombre() : empresa.getRazonSocial())%></p></div><% if(empresa!=null && empresa.isAprobada()){ %><a class="btn magenta" href="#publicar"><i data-lucide="plus" aria-hidden="true"></i> Publicar una oferta</a><% } %></div>
    <nav class="dashboard-nav" aria-label="Secciones del panel"><a href="#candidatos">Candidatos</a><a href="#publicadas">Mis ofertas</a><a href="<%=request.getContextPath()%>/empresa/perfil">Presentación de mi empresa</a><% if(empresa!=null && empresa.isAprobada()){ %><a href="#publicar">Nueva oportunidad</a><% } %><a href="<%=request.getContextPath()%>/inicio#ofertas">Ver portal de empleos</a></nav>
    <% if ("oferta".equals(request.getParameter("ok"))) { %><div class="alert alert-success notice" role="status">Tu oferta fue publicada y ya está disponible en el portal.</div><% } %>
    <% if(empresaNotice!=null){ %><div class="alert alert-success" role="status"><%=h(empresaNotice)%></div><% } %><% if(empresaError!=null){ %><div class="alert alert-danger" role="alert"><%=h(empresaError)%></div><% } %>
    <% if (request.getAttribute("error") != null) { %><div class="alert alert-danger error" role="alert"><%=h(request.getAttribute("error"))%></div><% } %>
    <% if ("empresa".equals(request.getParameter("error"))) { %><div class="alert alert-danger error" role="alert">No se encontró el perfil de empresa asociado a tu cuenta.</div><% } %>
    <% if(empresa!=null){ %><div class="business-status"><div><strong>Estado de tu empresa: <%=h(empresa.getEstadoRevision())%></strong><p><%=empresa.isAprobada()?"Tu empresa puede publicar ofertas.":"Completa tu presentación y espera la aprobación para publicar."%></p><% if(empresa.getMotivoRevision()!=null && !empresa.getMotivoRevision().isEmpty()){ %><p><strong>Observaciones:</strong> <%=h(empresa.getMotivoRevision())%></p><% } %></div><a class="btn primary" href="<%=request.getContextPath()%>/empresa/perfil"><i data-lucide="file-pen-line" aria-hidden="true"></i> Editar presentación</a></div><% } %>
    <% if("ficha".equals(request.getParameter("ok"))){ %><div class="alert alert-success" role="status">Ficha enviada. El administrador revisará tu solicitud.</div><% } %>
    <section class="section" id="candidatos"><div class="section-toolbar"><h2>Seguimiento de postulaciones <span class="badge"><%=candidatos.size()%></span></h2><input class="form-control" type="search" data-table-search="candidate-table" aria-label="Buscar candidatos" placeholder="Candidato, oferta o estado"></div><div class="table-wrap table-responsive"><table class="table table-hover align-middle" id="candidate-table"><thead><tr><th>Candidato</th><th>Oferta</th><th>Fecha</th><th>Estado</th><th>Perfil</th><th>Decisión</th></tr></thead><tbody>
    <% for(Postulacion p:candidatos){ %><tr><td><strong><%=h(p.getPostulante())%></strong><br><small><%=h(p.getTitular().isEmpty()?p.getCorreo():p.getTitular())%></small></td><td><%=h(p.getOferta())%></td><td><%=h(p.getFechaPostulacion())%></td><td><span class="badge"><%=h(p.getEstado())%></span></td><td><a class="btn" href="<%=request.getContextPath()%>/empresa/candidato?id=<%=p.getIdPostulacion()%>"><i data-lucide="contact-round" aria-hidden="true"></i> Ver perfil y evaluación</a></td><td><div class="candidate-inline-actions"><form class="candidate-inline-actions" method="post" action="<%=request.getContextPath()%>/empresa/postulacion"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("empresaCsrf"))%>"><input type="hidden" name="id" value="<%=p.getIdPostulacion()%>"><button class="icon-btn" name="estado" value="en revision" type="submit" title="Pasar a revisión" aria-label="Pasar a revisión"><i data-lucide="scan-search"></i></button><button class="icon-btn candidate-accept" name="estado" value="aceptado" type="submit" title="Admitir" aria-label="Admitir"><i data-lucide="user-check"></i></button></form><form method="post" action="<%=request.getContextPath()%>/empresa/postulacion" onsubmit="return confirm('¿Eliminar definitivamente esta postulación y su evaluación de Recursos Humanos? El postulante recibirá una notificación.');"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("empresaCsrf"))%>"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="<%=p.getIdPostulacion()%>"><button class="icon-btn danger-action" type="submit" title="Eliminar postulación" aria-label="Eliminar postulación"><i data-lucide="trash-2"></i></button></form></div></td></tr><% } %>
    <% if(candidatos.isEmpty()){ %><tr><td colspan="6">Aún no hay postulaciones para tus ofertas.</td></tr><% } %></tbody></table></div></section>
    <section class="section" id="evaluaciones-rrhh"><div class="section-toolbar"><div><h2>Evaluaciones recibidas de Recursos Humanos <span class="badge"><%=evaluacionesRrhh.size()%></span></h2><p class="muted">Solo aparecen evaluaciones que Recursos Humanos haya marcado como publicadas.</p></div></div><div class="table-wrap table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Candidato</th><th>Oferta</th><th>Etapa</th><th>CV</th><th>Entrevista</th><th>Desempeño</th><th>Compatibilidad</th><th>Veredicto</th><th>Detalle</th></tr></thead><tbody><% for(EvaluacionRRHH e:evaluacionesRrhh){ %><tr><td><strong><%=h(e.getNombrePostulante())%></strong></td><td><%=h(e.getTituloOferta())%></td><td><span class="badge"><%=h(e.getEtapa())%></span></td><td><%=e.getPuntajeCv()%>%</td><td><%=e.getPuntajeEntrevista()%>%</td><td><%=e.getPuntajeDesempeno()%>%</td><td><strong><%=e.getPorcentajeCompatibilidad()%>%</strong></td><td><span class="badge"><%=h(e.getResultado())%></span></td><td><a class="btn" href="<%=request.getContextPath()%>/empresa/candidato?id=<%=e.getIdPostulacion()%>">Ver evaluación</a></td></tr><% } %><% if(evaluacionesRrhh.isEmpty()){ %><tr><td colspan="9">Todavía no hay evaluaciones publicadas para tus candidatos.</td></tr><% } %></tbody></table></div></section>
    <section class="section" id="publicadas"><div class="section-toolbar"><h2>Mis ofertas <span class="badge"><%=ofertas.size()%></span></h2><input class="form-control" type="search" data-table-search="company-offers" aria-label="Buscar entre mis ofertas" placeholder="Buscar en mis ofertas"></div><div class="table-wrap table-responsive"><table class="table table-hover align-middle" id="company-offers"><thead><tr><th scope="col">Puesto</th><th scope="col">Modalidad</th><th scope="col">Ubicación</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody>
        <% for (Oferta o : ofertas) { %><tr><td><strong><%=h(o.getTitulo())%></strong></td><td><%=h(o.getModalidad())%></td><td><%=h(o.getUbicacion())%></td><td><span class="badge"><%=h(o.getEstado())%></span></td><td><div class="table-actions"><% if ("activa".equals(o.getEstado())) { %><a class="icon-btn" title="Ver oferta" href="<%=request.getContextPath()%>/inicio?oferta=<%=o.getIdOferta()%>#ofertas" aria-label="Ver <%=h(o.getTitulo())%>"><i data-lucide="external-link" aria-hidden="true"></i></a><% } %><a class="icon-btn" title="Editar oferta" href="<%=request.getContextPath()%>/empresa?editar=<%=o.getIdOferta()%>#publicar" aria-label="Editar <%=h(o.getTitulo())%>"><i data-lucide="pencil" aria-hidden="true"></i></a><% if("activa".equals(o.getEstado())){ %><form method="post" action="<%=request.getContextPath()%>/oferta" onsubmit="return confirm('¿Cerrar esta oferta? Dejará de aceptar postulaciones nuevas y conservará su historial.');"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("empresaCsrf"))%>"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="<%=o.getIdOferta()%>"><button class="icon-btn danger-action" type="submit" title="Cerrar oferta" aria-label="Cerrar <%=h(o.getTitulo())%>"><i data-lucide="archive" aria-hidden="true"></i></button></form><% } %></div></td></tr><% } %>
        <% if (ofertas.isEmpty()) { %><tr><td colspan="5">Aún no has publicado ofertas.</td></tr><% } %>
    </tbody></table></div></section>
    <% if(empresa!=null && empresa.isAprobada()){ String valorTitulo=ofertaEditar==null?request.getParameter("titulo"):ofertaEditar.getTitulo(); String valorModalidad=ofertaEditar==null?request.getParameter("modalidad"):ofertaEditar.getModalidad(); String valorUbicacion=ofertaEditar==null?request.getParameter("ubicacion"):ofertaEditar.getUbicacion(); String valorSalario=ofertaEditar==null?request.getParameter("salario"):String.valueOf(ofertaEditar.getSalario()); String valorAdaptaciones=ofertaEditar==null?request.getParameter("adaptaciones"):ofertaEditar.getAdaptaciones(); String valorDescripcion=ofertaEditar==null?request.getParameter("descripcion"):ofertaEditar.getDescripcion(); %><section class="section" id="publicar"><h2><%=ofertaEditar==null?"Publica una nueva oportunidad":"Editar oferta laboral"%></h2><p class="muted"><%=ofertaEditar==null?"Describe el puesto y los apoyos que tu empresa puede ofrecer.":"Actualiza la información de esta oportunidad. Solo tu empresa puede guardar estos cambios."%></p><form class="publish-form" method="post" action="<%=request.getContextPath()%>/oferta"><input type="hidden" name="csrf" value="<%=h(session.getAttribute("empresaCsrf"))%>"><input type="hidden" name="accion" value="<%=ofertaEditar==null?"crear":"editar"%>"><% if(ofertaEditar!=null){ %><input type="hidden" name="id" value="<%=ofertaEditar.getIdOferta()%>"><% } %><div class="row g-3">
        <div class="field col-md-6"><label for="titulo">Título del puesto</label><input class="form-control" id="titulo" name="titulo" maxlength="150" placeholder="Ej. Analista de soporte" value="<%=h(valorTitulo)%>" required></div>
        <div class="field col-md-6"><label for="modalidad">Modalidad</label><select class="form-select" id="modalidad" name="modalidad"><% for (String m : new String[]{"Presencial accesible","Remoto","Hibrido"}) { %><option value="<%=m%>" <%=m.equals(valorModalidad) ? "selected" : ""%>><%="Hibrido".equals(m) ? "Híbrido" : m%></option><% } %></select></div>
        <div class="field col-md-6"><label for="ubicacion">Ciudad o distrito</label><input class="form-control" id="ubicacion" name="ubicacion" maxlength="120" placeholder="Ej. Miraflores, Lima" value="<%=h(valorUbicacion)%>" required></div>
        <div class="field col-md-6"><label for="salario">Salario mensual referencial (S/)</label><input class="form-control" id="salario" name="salario" type="number" min="0" max="99999999.99" step="0.01" value="<%=valorSalario == null ? "1500" : h(valorSalario)%>" required></div>
        <% request.setAttribute("apoyosSeleccionados", ofertaEditar==null ? (request.getParameterValues("apoyos")==null ? "" : String.join(",",request.getParameterValues("apoyos"))) : ofertaEditar.getApoyos()); %>
        <%@include file="WEB-INF/jspf/apoyos-form.jspf"%>
        <div class="field col-12"><label for="adaptaciones">Detalle y condiciones de las adaptaciones</label><input class="form-control" id="adaptaciones" name="adaptaciones" maxlength="255" value="<%=h(valorAdaptaciones)%>" required></div>
        <% if(ofertaEditar!=null){ %><div class="field col-md-6"><label for="estado">Estado de publicación</label><select class="form-select" id="estado" name="estado"><option value="activa" <%= "activa".equals(ofertaEditar.getEstado())?"selected":"" %>>Activa</option><option value="cerrada" <%= "cerrada".equals(ofertaEditar.getEstado())?"selected":"" %>>Cerrada</option></select></div><% } %>
        <div class="field col-12"><label for="descripcion">Descripción completa del puesto</label><textarea class="form-control" id="descripcion" name="descripcion" maxlength="10000" rows="14" required><%=h(valorDescripcion)%></textarea><small>Usa ## para los títulos y - para cada punto de una lista. Esta información aparecerá ordenada en “Ver oferta”.</small></div>
    </div><div class="form-actions"><button class="btn primary" type="submit"><%=ofertaEditar==null?"Publicar oferta":"Guardar cambios"%> <i data-lucide="arrow-right" aria-hidden="true"></i></button><% if(ofertaEditar!=null){ %><a class="btn" href="<%=request.getContextPath()%>/empresa#publicadas">Cancelar edición</a><% } %></div></form></section><% } %>
</main><%@include file="WEB-INF/jspf/footer.jspf"%></body></html>
